{
  "name": "lakehouse-medallion-daily",
  "description": "Databricks Jobs API 2.1 definition: an alternative to ADF for running the three layers as dependent tasks.",
  "parameters": [
    { "name": "batch_date", "default": "{{job.start_time.iso_date}}" },
    { "name": "storage_root", "default": "abfss://lakehouse@<storage-account>.dfs.core.windows.net" }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "etl",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "autoscale": { "min_workers": 1, "max_workers": 4 },
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "job_cluster_key": "etl",
      "python_wheel_task": {
        "package_name": "azure_lakehouse_medallion_banking",
        "entry_point": "lakehouse-pipeline",
        "parameters": ["--config", "/Workspace/lakehouse/conf/pipeline.yaml", "--root", "{{job.parameters.storage_root}}",
                       "--batch-date", "{{job.parameters.batch_date}}", "--layers", "bronze"]
      },
      "libraries": [ { "whl": "/Workspace/lakehouse/wheels/azure_lakehouse_medallion_banking-1.0.0-py3-none-any.whl" } ],
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    },
    {
      "task_key": "silver",
      "depends_on": [ { "task_key": "bronze" } ],
      "job_cluster_key": "etl",
      "python_wheel_task": {
        "package_name": "azure_lakehouse_medallion_banking",
        "entry_point": "lakehouse-pipeline",
        "parameters": ["--config", "/Workspace/lakehouse/conf/pipeline.yaml", "--root", "{{job.parameters.storage_root}}",
                       "--batch-date", "{{job.parameters.batch_date}}", "--layers", "silver"]
      },
      "libraries": [ { "whl": "/Workspace/lakehouse/wheels/azure_lakehouse_medallion_banking-1.0.0-py3-none-any.whl" } ],
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    },
    {
      "task_key": "gold",
      "depends_on": [ { "task_key": "silver" } ],
      "job_cluster_key": "etl",
      "python_wheel_task": {
        "package_name": "azure_lakehouse_medallion_banking",
        "entry_point": "lakehouse-pipeline",
        "parameters": ["--config", "/Workspace/lakehouse/conf/pipeline.yaml", "--root", "{{job.parameters.storage_root}}",
                       "--batch-date", "{{job.parameters.batch_date}}", "--layers", "gold"]
      },
      "libraries": [ { "whl": "/Workspace/lakehouse/wheels/azure_lakehouse_medallion_banking-1.0.0-py3-none-any.whl" } ],
      "max_retries": 1
    }
  ],
  "email_notifications": { "on_failure": ["data-eng-oncall@example.com"] },
  "schedule": { "quartz_cron_expression": "0 0 2 * * ?", "timezone_id": "UTC", "pause_status": "PAUSED" }
}
